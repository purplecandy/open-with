#!/usr/bin/env bash
#
# open-with - set the default macOS application for file types, without the shenanigans.
#
# Pure macOS. No Homebrew, no duti, no compilers. Talks to LaunchServices directly
# through the JavaScript-for-Automation ObjC bridge that ships with every Mac.
#
# https://github.com/purplecandy/open-with
#
set -euo pipefail

VERSION="1.0.0"
LSREGISTER="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

# Append-only journal of everything this tool has changed, so it can be undone.
STATE_DIR="${OPEN_WITH_STATE:-$HOME/.local/state/open-with}"
HISTORY_FILE="$STATE_DIR/history.tsv"
HISTORY_MAX=2000

