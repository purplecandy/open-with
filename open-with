# @name -> the extensions in that catalog group, one per line. Fails (prints
# nothing, returns 1) for a name that is not a group.
group_extensions() {
  local name
  name="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  case "$name" in
    txt) name="text" ;;
    img) name="images" ;;
    zip) name="archives" ;;
  esac
  if [[ "$name" == "media" ]]; then
    group_extensions images; group_extensions audio; group_extensions video
    return 0
  fi
  local exts
  exts="$(printf '%s\n' "$CATALOG" | awk -v g="$name" '$1 == g { print $2 }')"
  [[ -n "$exts" ]] || return 1
  printf '%s\n' "$exts"
}

show_groups() {
  printf '\n%s%-11s %s%s\n' "$BOLD" "GROUP" "EXTENSIONS" "$RESET"
  local g
  while IFS= read -r g; do
    printf '%-11s %s\n' "@$g" "$(group_extensions "$g" | tr '\n' ' ')"
  done < <(printf '%s\n' "$CATALOG" | awk '!seen[$1]++ { print $1 }')
  printf '%-11s %s\n' "@media" "everything in @images, @audio and @video"
  printf '\n%sAliases: @txt = @text, @img = @images, @zip = @archives%s\n' "$DIM" "$RESET"
  printf '%sAnything not listed can still be given by hand: open-with astro -w Zed%s\n\n' "$DIM" "$RESET"
}

# ---------------------------------------------------------------- presentation

if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RED=$'\033[31m'; GREEN=$'\033[32m'
  YELLOW=$'\033[33m'; CYAN=$'\033[36m'; RESET=$'\033[0m'
else
  BOLD=''; DIM=''; RED=''; GREEN=''; YELLOW=''; CYAN=''; RESET=''
fi

QUIET=0
die()  { printf '%sopen-with:%s %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }
warn() { [[ $QUIET -eq 1 ]] || printf '%s!%s %s\n' "$YELLOW" "$RESET" "$*" >&2; }
info() { [[ $QUIET -eq 1 ]] || printf '%s›%s %s\n' "$DIM" "$RESET" "$*" >&2; }

usage() {
  cat <<'HELPDOC'
open-with - set the default macOS app for file types

USAGE
  open-with [TYPE...] [-w APP] [options]
  open-with history
  open-with undo [last | N]

TYPE may be given in any of these forms (mix freely):
  md  .md  '*.md'         filename extension
  text/markdown           MIME type
  net.daringfireball.md   Uniform Type Identifier (UTI)
  ~/notes/todo.md         an actual file (its extension is used)
  @images  @code  @media  a group of extensions (see --groups)

APP may be a name, a path, or a bundle identifier:
  -w Zed                  -w "Visual Studio Code"
  -w /Applications/Zed.app
  -w dev.zed.Zed

Omit TYPE and you get an interactive type picker. Extensions that are not in
the list can be typed there, or passed on the command line as usual.
Omit -w and you get a picker of apps that can open the chosen types.

OPTIONS
  -w, --with APP     application to open these types with
  -l, --list         show the current handler for TYPE (or for common types)
      --groups       list the @groups and the extensions in each
      --history      list every change this tool has made
      --undo [N]     revert a change (same as the undo subcommand)
  -a, --all-apps     picker lists every installed app, not just capable ones
  -d, --doctor       find and remove stale LaunchServices registrations
  -n, --dry-run      show what would change, change nothing
  -y, --yes          don't ask for confirmation
  -q, --quiet        suppress notes and warnings (errors still print)
  -h, --help         show this help
  -V, --version      show version

EXAMPLES
  open-with md json -w Zed          set Zed as default for Markdown and JSON
  open-with @images -w Preview      every common image type to Preview
  open-with @code @web @data -w Zed  everything a text editor should own
  open-with                         pick types, then pick an app
  open-with -w Zed                  pick types, set them all to Zed
  open-with -l md json              what opens these right now?
  open-with --doctor                clean up ghost app registrations
  open-with history                 everything this tool has changed
  open-with undo last               put the most recent change back
  open-with undo                    pick a change from the log to revert
  open-with undo 3                  revert entry 3 from the history

HELPDOC
}

# --------------------------------------------------------- LaunchServices glue
#
# Uses NSWorkspace and UTType, the current (non-deprecated) way to talk to
# LaunchServices. One osascript process per call, so every verb takes a batch
# of arguments. Fields are tab separated.

jxa() {
  osascript -l JavaScript - "$@" <<'JXA_EOF'
ObjC.import('AppKit');

// UniformTypeIdentifiers ships no bridge metadata, so ObjC.import() cannot see
// it. AppKit already loads the framework, so ask the runtime for the class.
var UTType = $.NSClassFromString('UTType');
var ws     = $.NSWorkspace.sharedWorkspace;

function tabsafe(v) { return String(v == null ? '' : v).replace(/[\t\n]/g, ' '); }

// Optional NSString -> JS string or null.
function str(nsstr) { return (nsstr && nsstr.js !== undefined) ? nsstr.js : null; }

function bundleId(url) {
  var b = $.NSBundle.bundleWithURL(url);
  return (b.js === undefined) ? null : str(b.bundleIdentifier);
}

function appInfo(bid) {
  var url = ws.URLForApplicationWithBundleIdentifier(bid);
  if (url.js === undefined) return { bid: bid, name: bid, path: '' };
  var path = url.path.js;
  return { bid: bid, name: path.split('/').pop().replace(/\.app$/, ''), path: path };
}

// Current default handler for a type, as a bundle id, or null.
function handlerFor(type) {
  var url = ws.URLForApplicationToOpenContentType(type);
  return url.js === undefined ? null : bundleId(url);
}

// Every app that can open a type, as bundle ids.
function handlersFor(type) {
  var urls = ws.URLsForApplicationsToOpenContentType(type), out = [];
  for (var i = 0; i < urls.count; i++) {
    var b = bundleId(urls.objectAtIndex(i));
    if (b) out.push(b);
  }
  return out;
}

// A token is a MIME type, a UTI, or a bare filename extension. Returns a
// UTType (or null) plus which reading was used.
function resolveType(tok) {
  var t;
  if (tok.indexOf('/') >= 0) {
    t = UTType.typeWithMIMEType(tok);
    return { type: t.js === undefined ? null : t, how: 'mime' };
  }
  // Only a UTI if the system knows it; that keeps "tar.gz" from being mistaken
  // for one. Dynamic identifiers (dyn.*) are known once they have been minted.
  if (tok.indexOf('.') >= 0) {
    t = UTType.typeWithIdentifier(tok);
    if (t.js !== undefined) return { type: t, how: 'uti' };
  }
  t = UTType.typeWithFilenameExtension(tok);
  return { type: t.js === undefined ? null : t, how: 'ext' };
}

// token  uti  how  declared  description  current_bundle_id  current_app_name
function verbResolve(args) {
  return args.map(function (tok) {
    var r = resolveType(tok);
    if (!r.type) return [tok, '', r.how, '0', '', '', ''].map(tabsafe).join('\t');
    var declared = r.type.isDeclared && !r.type.isDynamic;
    var cur = handlerFor(r.type);
    return [tok, r.type.identifier.js, r.how, declared ? '1' : '0',
            str(r.type.localizedDescription), cur, cur ? appInfo(cur).name : '']
      .map(tabsafe).join('\t');
  }).join('\n');
}

// Apps that declare they can open these types, ranked by how many they cover.
function verbCandidates(utis) {
  var score = {}, order = [];
  utis.forEach(function (uti) {
    var type = UTType.typeWithIdentifier(uti);
    if (type.js === undefined) return;
    handlersFor(type).forEach(function (bid) {
      if (score[bid] === undefined) { score[bid] = 0; order.push(bid); }
      score[bid]++;
    });
  });
  return order
    .map(function (bid) { var a = appInfo(bid); a.n = score[bid]; return a; })
    .filter(function (a) { return a.path !== ''; })
    .sort(function (x, y) { return y.n - x.n || x.name.localeCompare(y.name); })
    .map(function (a) { return [a.n, a.bid, a.name, a.path].map(tabsafe).join('\t'); })
    .join('\n');
}

function verbApps() {
  var fm = $.NSFileManager.defaultManager;
  var dirs = ['/Applications', '/Applications/Utilities', '/System/Applications',
              '/System/Applications/Utilities',
              $.NSHomeDirectory().js + '/Applications'];
  var seen = {}, out = [];
  dirs.forEach(function (dir) {
    var items = fm.contentsOfDirectoryAtPathError(dir, $());
    if (items.js === undefined) return;
    for (var i = 0; i < items.count; i++) {
      var name = items.objectAtIndex(i).js;
      if (!/\.app$/.test(name)) continue;
      var path = dir + '/' + name;
      var bid = bundleId($.NSURL.fileURLWithPath(path));
      if (!bid || seen[bid]) continue;
      seen[bid] = true;
      out.push(['1', bid, name.replace(/\.app$/, ''), path].map(tabsafe).join('\t'));
    }
  });
  return out.sort().join('\n');
}

// name | path | bundle id -> bundle id, name, path
function verbApp(query) {
  var tries = [];
  if (/\.app\/?$/.test(query)) {
    var b = bundleId($.NSURL.fileURLWithPath(query.replace(/\/$/, '')));
    if (b) tries.push(b);
  }
  var byName = ws.fullPathForApplication(query.replace(/\.app$/, ''));
  if (byName.js !== undefined) {
    var nb = bundleId($.NSURL.fileURLWithPath(byName.js));
    if (nb) tries.push(nb);
  }
  if (ws.URLForApplicationWithBundleIdentifier(query).js !== undefined) tries.push(query);

  for (var i = 0; i < tries.length; i++) {
    var a = appInfo(tries[i]);
    if (a.path !== '') return [a.bid, a.name, a.path].map(tabsafe).join('\t');
  }
  return '';
}

// uti  ok|fail  current_bundle_id
//
// NSWorkspace's setter is asynchronous and reports through a completion block,
// which JXA cannot receive. So: fire it, pump the run loop until the change is
// visible, and give up after a few seconds.
function verbSet(args) {
  var bid = args.shift();
  var app = ws.URLForApplicationWithBundleIdentifier(bid);
  return args.map(function (uti) {
    var type = UTType.typeWithIdentifier(uti);
    if (app.js === undefined || type.js === undefined) return [uti, 'fail', ''].join('\t');

    ws.setDefaultApplicationAtURLToOpenContentTypeCompletionHandler(app, type, $());
    var now = handlerFor(type), deadline = Date.now() + 3000;
    while (now !== bid && Date.now() < deadline) {
      $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.02));
      now = handlerFor(type);
    }
    return [uti, now === bid ? 'ok' : 'fail', now].map(tabsafe).join('\t');
  }).join('\n');
}

// Does this app actually declare support for the type? Purely advisory.
function verbDeclares(args) {
  var bid = args.shift();
  return args.map(function (uti) {
    var type = UTType.typeWithIdentifier(uti);
    var yes = type.js !== undefined && handlersFor(type).indexOf(bid) >= 0;
    return [uti, yes ? '1' : '0'].join('\t');
  }).join('\n');
}

function verbNames(bids) {
  return bids.map(function (bid) {
    return [bid, appInfo(bid).name].map(tabsafe).join('\t');
  }).join('\n');
}

function run(argv) {
  var verb = argv.shift();
  switch (verb) {
    case 'names':      return verbNames(argv);
    case 'resolve':    return verbResolve(argv);
    case 'candidates': return verbCandidates(argv);
    case 'apps':       return verbApps();
    case 'app':        return verbApp(argv[0]);
    case 'set':        return verbSet(argv);
    case 'declares':   return verbDeclares(argv);
  }
  return '';
}
JXA_EOF
}

# ------------------------------------------------------------ ghost registrations
#
# lsregister -dump emits dash-delimited records. We want records whose app path
# no longer exists and which are not helper bundles nested inside another app.

ghost_paths() {
  "$LSREGISTER" -dump 2>/dev/null | awk '
    /^-{10,}$/ { if (p != "") print p; p = ""; next }
    /^[ \t]*path:[ \t]+\// {
      if (p == "") {
        line = $0
        sub(/^[ \t]*path:[ \t]+/, "", line)
        sub(/ \(0x[0-9a-f]+\)$/, "", line)
        if (line ~ /\.app$/) p = line
      }
    }
    END { if (p != "") print p }
  ' | sort -u | while IFS= read -r p; do
    case "$p" in */Contents/*) continue ;; esac
    [[ -e "$p" ]] || printf '%s\n' "$p"
  done
}

unregister_paths() {
  local p count=0
  while IFS= read -r p; do
    [[ -n "$p" ]] || continue
    [[ $DRY_RUN -eq 1 ]] || "$LSREGISTER" -u "$p" >/dev/null 2>&1 || true
    count=$((count + 1))
  done
  printf '%s\n' "$count"
}

# Clear ghosts that share a name with the app we are about to install as handler.
# This is the specific failure that produces "the application has been moved to
# the Trash" for an app that is plainly still installed.
clear_shadowing_ghosts() {
  local app_path="$1" base ghosts n
  base="$(basename "$app_path")"
  info "Checking for stale registrations of $base (this takes a few seconds)..."
  ghosts="$(ghost_paths | grep -F "/$base" || true)"
  [[ -n "$ghosts" ]] || return 0

  n="$(printf '%s\n' "$ghosts" | grep -c . || true)"
  local verb="cleared"
  [[ $DRY_RUN -eq 1 ]] && verb="would clear"
  printf '%s\n' "${YELLOW}Found $n stale registration(s) shadowing $base:${RESET}" >&2
  printf '%s\n' "$ghosts" | unregister_paths >/dev/null
  printf '%s\n' "$ghosts" | sed "s|^|  ${DIM}${verb}${RESET} |" >&2

  [[ $DRY_RUN -eq 1 ]] || "$LSREGISTER" -f -R "$app_path" >/dev/null 2>&1 || true
}

doctor() {
  local ghosts n
  info "Scanning the LaunchServices database..."
  ghosts="$(ghost_paths || true)"

  if [[ -z "$ghosts" ]]; then
    printf '%s✓%s No stale app registrations. Nothing to do.\n' "$GREEN" "$RESET"
    return 0
  fi

  n="$(printf '%s\n' "$ghosts" | grep -c . || true)"
  printf '\n%sFound %s registration(s) pointing at apps that no longer exist:%s\n\n' "$BOLD" "$n" "$RESET"
  printf '%s\n' "$ghosts" | awk -v d="$DIM" -v r="$RESET" '
    { if ($0 ~ /^\/Volumes\//)      b = "unmounted disk image"
      else if ($0 ~ /\.Trash/)      b = "in the Trash"
      else if ($0 ~ /Temp|\/T\//)   b = "temp folder"
      else                          b = "missing"
      printf "  %-22s %s%s%s\n", "[" b "]", d, $0, r }'

  printf '\nThese are what make macOS insist an installed app "cannot be found".\n'

  if [[ $DRY_RUN -eq 1 ]]; then
    printf '\n%sDry run - nothing was unregistered.%s\n' "$YELLOW" "$RESET"
    return 0
  fi

  if [[ $ASSUME_YES -eq 0 ]]; then
    printf '\n%sUnregister all %s?%s [y/N] ' "$BOLD" "$n" "$RESET"
    local reply; read -r reply </dev/tty || reply=""
    [[ "$reply" =~ ^[Yy] ]] || { info "Left untouched."; return 0; }
  fi

  printf '\n'
  printf '%s\n' "$ghosts" | unregister_paths >/dev/null

  # Recorded for the audit trail only; a registration for a deleted app
  # cannot be put back, and would be useless if it could.
  local dgroup path
  dgroup="$(history_new_group)"
  while IFS= read -r path; do
    [[ -n "$path" ]] && history_record "$dgroup" unregister "$path" "" "" "doctor"
  done <<< "$ghosts"

  printf '\n%s✓%s Cleaned %s stale registration(s). Installed apps were not touched.\n' "$GREEN" "$RESET" "$n"
}

# ---------------------------------------------------------------------- pickers

have_fzf() { command -v fzf >/dev/null 2>&1; }

# Reads "key<TAB>display" lines on stdin, writes chosen keys on stdout.
# With a fourth argument, the user may also type entries that are not in the
# list (used by the type picker so unlisted extensions can be added).
pick() {
  local prompt="$1" multi="$2" header="$3" custom="${4:-}" lines
  lines="$(cat)"
  [[ -n "$lines" ]] || return 1

  if have_fzf; then
    local hint="(ENTER to choose)"
    [[ "$multi" == "multi" ]] && hint="(TAB to mark, ENTER to confirm)"
    [[ -n "$custom" ]] && hint="$hint - or type an extension that is not listed"
    local -a args=(--ansi --prompt="$prompt > " --height=80% --reverse
                   --delimiter=$'\t' --with-nth=2.. --header="$header  $hint")
    [[ "$multi" == "multi" ]] && args+=(--multi --marker='+')
    [[ -n "$custom" ]] && args+=(--print-query)

    local out rc=0
    out="$(printf '%s\n' "$lines" | fzf "${args[@]}")" || rc=$?

    if [[ -n "$custom" ]]; then
      # --print-query puts what was typed on the first line. Exit 0 means
      # something was selected as well; exit 1 means nothing matched, so the
      # typed text is the answer.
      local query="${out%%$'\n'*}"
      if [[ $rc -eq 0 ]]; then
        out="${out#*$'\n'}"
      elif [[ $rc -eq 1 && -n "$query" ]]; then
        local -a words
        read -ra words <<< "$query"
        printf '%s\n' "${words[@]}"
        return 0
      else
        return 1
      fi
    elif [[ $rc -ne 0 ]]; then
      return 1
    fi
    printf '%s\n' "$out" | cut -f1
    return 0
  fi

  # Numbered fallback, no dependencies.
  printf '\n%s%s%s\n' "$BOLD" "$header" "$RESET" >&2
  printf '%s\n' "$lines" | awk -F'\t' -v c="$CYAN" -v r="$RESET" \
    '{ printf "  %s%3d%s  %s\n", c, NR, r, $2 }' >&2
  if [[ "$multi" == "multi" && -n "$custom" ]]; then
    printf '\n%s → numbers, ranges (1-4), "all", or an extension not listed:%s ' "$BOLD$prompt" "$RESET" >&2
  elif [[ "$multi" == "multi" ]]; then
    printf '\n%s → numbers, ranges (1-4), or "all":%s ' "$BOLD$prompt" "$RESET" >&2
  else
    printf '\n%s → number:%s ' "$BOLD$prompt" "$RESET" >&2
  fi

  local reply; read -r reply </dev/tty || reply=""
  [[ -n "$reply" ]] || return 1

  printf '%s\n' "$lines" | awk -F'\t' -v sel="$reply" -v multi="$multi" -v custom="$custom" '
    BEGIN {
      if (sel == "all" || sel == "a") { all = 1 }
      gsub(/,/, " ", sel)
      n = split(sel, parts, / +/)
      for (i = 1; i <= n; i++) {
        if (parts[i] ~ /^[0-9]+-[0-9]+$/) {
          split(parts[i], rr, "-")
          for (j = rr[1]; j <= rr[2]; j++) want[j] = 1
        } else if (parts[i] ~ /^[0-9]+$/) want[parts[i]] = 1
        else if (custom != "" && !all && parts[i] != "") extra[++ne] = parts[i]
      }
    }
    (all || want[NR]) { print $1; if (multi != "multi") exit }
    END { for (i = 1; i <= ne; i++) print extra[i] }
  '
}

pick_types() {
  local tokens resolved
  tokens="$(printf '%s\n' "$CATALOG" | awk '{print $2}')"
  # shellcheck disable=SC2046
  resolved="$(jxa resolve $(printf '%s\n' "$tokens" | tr '\n' ' '))"

  paste <(printf '%s\n' "$CATALOG" | awk '{print $1}') <(printf '%s\n' "$resolved") \
    | awk -F'\t' -v d="$DIM" -v g="$GREEN" -v r="$RESET" '
        $3 != "" {
          cur = ($8 != "" ? $8 : "-")
          printf "%s\t%-9s %-12s %s%-28s%s %s→ %s%s\n", $2, $1, $2, d, ($6 == "" ? $3 : $6), r, d, cur, r
        }' \
    | pick "types" multi "Select file types" custom
}

pick_app() {
  local verb="candidates" listing
  [[ $ALL_APPS -eq 1 ]] && verb="apps"

  if [[ "$verb" == "candidates" ]]; then
    listing="$(jxa candidates "$@" || true)"
  else
    listing="$(jxa apps || true)"
  fi
  [[ -n "$listing" ]] || return 1

  printf '%s\n' "$listing" | awk -F'\t' -v total="$#" -v d="$DIM" -v r="$RESET" -v y="$YELLOW" '
    {
      flag = (total > 1 && $1 != "" && $1 + 0 < total) ? y "partial" r : "       "
      printf "%s\t%-26s %s  %s%s%s\n", $2, $3, flag, d, $4, r
    }' \
    | pick "app" single "Open these with"
}

# ---------------------------------------------------------------------- history
#
# One tab-separated line per changed type:
#   epoch  iso  group  action  uti  previous_bundle_id  new_bundle_id  app  note  token
# `token` is the type as the user typed it (md, text/markdown, ...), for display.
# `group` ties one invocation together, so undo reverts a whole command.

history_new_group() { printf '%s-%s\n' "$(date +%s)" "$$"; }

history_record() {
  local group="$1" action="$2" uti="$3" prev="$4" new="$5" app="$6" note="${7:-}" token="${8:-}"
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date +%s)" "$(date '+%Y-%m-%d %H:%M')" "$group" "$action" \
    "$uti" "$prev" "$new" "$app" "$note" "$token" >> "$HISTORY_FILE"

  # Keep the journal from growing without bound.
  local n
  n="$(wc -l < "$HISTORY_FILE" 2>/dev/null || echo 0)"
  if [[ "$n" -gt $((HISTORY_MAX * 2)) ]]; then
    tail -n "$HISTORY_MAX" "$HISTORY_FILE" > "$HISTORY_FILE.tmp" 2>/dev/null \
      && mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
  fi
}

# Collapses the journal into one line per group, newest first:
#   group  iso  app  count  summary  undoable
history_groups() {
  [[ -s "$HISTORY_FILE" ]] || return 1
  awk -F'\t' '
    {
      g = $3
      if (!(g in seen)) { seen[g] = 1; order[++k] = g; iso[g] = $2; note[g] = $9 }
      if ($8 != "" && !((g SUBSEP $8) in appseen)) {
        appseen[g SUBSEP $8] = 1
        napps[g]++
        app[g] = ($8)
      }
      act[g]   = $4
      count[g]++
      if ($4 == "set") {
        if ($10 != "") { short = $10 }
        else if ($5 ~ /^dyn\./) { short = "(dynamic type)" }
        else { short = $5; sub(/^.*\./, "", short) }
        summary[g] = (summary[g] == "" ? short : summary[g] ", " short)
        if ($6 != "") undoable[g] = 1
      } else {
        summary[g] = count[g] " stale registration(s)"
      }
    }
    END {
      for (i = k; i >= 1; i--) {
        g = order[i]
        label = (napps[g] > 1) ? ("several (" napps[g] ")") : app[g]
        printf "%s\t%s\t%s\t%s\t%s\t%s\n", g, iso[g], label, count[g],
               summary[g], (undoable[g] ? "1" : "0")
      }
    }
  ' "$HISTORY_FILE"
}

show_history() {
  local groups
  groups="$(history_groups || true)"
  if [[ -z "$groups" ]]; then
    printf '\n%sNo changes recorded yet.%s\n\n' "$DIM" "$RESET"
    return 0
  fi
  printf '\n%s%-4s %-17s %-20s %s%s\n' "$BOLD" "#" "WHEN" "APP" "TYPES" "$RESET"
  printf '%s\n' "$groups" | awk -F'\t' -v d="$DIM" -v r="$RESET" -v y="$YELLOW" '
    {
      mark = ($6 == "1") ? "" : y " (not undoable)" r
      printf "%-4d %-17s %-20s %s%s\n", NR, $2, ($3 == "" ? "-" : $3), $5, mark
    }'
  printf '\n%sUndo the most recent with:%s open-with undo last\n\n' "$DIM" "$RESET"
}

# Revert one group: put every type back to the handler it had before.
undo_group() {
  local group="$1" entries restorable app when
  entries="$(awk -F'\t' -v g="$group" '$3 == g && $4 == "set"' "$HISTORY_FILE" || true)"

  if [[ -z "$entries" ]]; then
    die "nothing undoable in that entry (ghost cleanups cannot be reversed - the apps are gone)"
  fi

  app="$(printf '%s\n' "$entries" | head -1 | cut -f8)"
  when="$(printf '%s\n' "$entries" | head -1 | cut -f2)"

  # Only types that had a previous handler can be restored.
  restorable="$(printf '%s\n' "$entries" | awk -F'\t' '$6 != ""' || true)"
  local orphans
  orphans="$(printf '%s\n' "$entries" | awk -F'\t' '$6 == "" { print $5 }' || true)"

  if [[ -z "$restorable" ]]; then
    warn "Those types had no previous default, and macOS offers no way to unset one."
    die "nothing to restore"
  fi

  printf '\n%sUndo %s from %s:%s\n' "$BOLD" "${app:-change}" "$when" "$RESET"
  local names uti prev new
  local -a prev_bids=()
  while IFS= read -r _b; do
    [[ -n "$_b" ]] && prev_bids+=("$_b")
  done < <(printf '%s\n' "$restorable" | cut -f6 | sort -u)
  names="$(jxa names "${prev_bids[@]+"${prev_bids[@]}"}" || true)"
  while IFS=$'\t' read -r _ _ _ _ uti prev new _ _; do
    [[ -n "$uti" ]] || continue
    local prev_name
    prev_name="$(printf '%s\n' "$names" | awk -F'\t' -v b="$prev" '$1 == b { print $2; exit }')"
    printf '  %-34s %s%s → %s%s\n' "$uti" "$DIM" "${app:-$new}" "${prev_name:-$prev}" "$RESET"
  done <<< "$restorable"

  if [[ -n "$orphans" ]]; then
    printf '\n'
    warn "these had no previous default and will be left as they are:"
    printf '  %s%s%s\n' "$DIM" "$(printf '%s\n' "$orphans" | tr '\n' ' ')" "$RESET" >&2
  fi

  if [[ $DRY_RUN -eq 1 ]]; then
    printf '\n%sDry run - nothing was changed.%s\n' "$YELLOW" "$RESET"
    return 0
  fi

  if [[ $ASSUME_YES -eq 0 && -t 0 ]]; then
    printf '\n%sProceed?%s [Y/n] ' "$BOLD" "$RESET"
    local reply; read -r reply </dev/tty || reply=""
    [[ -z "$reply" || "$reply" =~ ^[Yy] ]] || { info "Cancelled."; return 0; }
  fi

  # Group by target app so each restore is a single LaunchServices batch.
  local new_group failed=0
  new_group="$(history_new_group)"
  printf '\n'
  local target
  for target in $(printf '%s\n' "$restorable" | cut -f6 | sort -u); do
    local -a back=()
    while IFS=$'\t' read -r _ _ _ _ uti prev new _ _; do
      [[ "$prev" == "$target" ]] && back+=("$uti")
    done <<< "$restorable"
    [[ ${#back[@]} -gt 0 ]] || continue

    local results
    results="$(jxa set "$target" "${back[@]}")"
    while IFS=$'\t' read -r uti status now; do
      [[ -n "$uti" ]] || continue
      local was
      was="$(printf '%s\n' "$restorable" | awk -F'\t' -v u="$uti" '$5 == u { print $7; exit }')"
      if [[ "$status" == "ok" ]]; then
        printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$uti"
        history_record "$new_group" set "$uti" "$was" "$target" \
          "$(printf '%s\n' "$names" | awk -F'\t' -v b="$target" '$1 == b { print $2; exit }')" \
          "undo-of:$group" \
          "$(printf '%s\n' "$restorable" | awk -F'\t' -v u="$uti" '$5 == u { print $10; exit }')"
      else
        failed=1
        printf '  %s✗%s %s %s(still %s)%s\n' "$RED" "$RESET" "$uti" "$DIM" "${now:-unset}" "$RESET"
      fi
    done <<< "$results"
  done

  [[ $failed -eq 0 ]] || { printf '\n%sSome types could not be restored.%s\n' "$YELLOW" "$RESET"; return 1; }
  printf '\n%s✓%s Undone. (This undo is itself in the log - "open-with undo last" again to redo.)\n' "$GREEN" "$RESET"
}

do_undo() {
  local which="${1:-}"
  local groups
  groups="$(history_groups || true)"
  [[ -n "$groups" ]] || die "nothing to undo - no changes recorded yet"

  local target=""
  if [[ -z "$which" ]]; then
    [[ -t 0 ]] || die "no entry given and no terminal to ask on"
    target="$(printf '%s\n' "$groups" | awk -F'\t' -v d="$DIM" -v r="$RESET" -v y="$YELLOW" '
      { mark = ($6 == "1") ? "" : y " (not undoable)" r
        printf "%s\t%-17s %-20s %s%s\n", $1, $2, ($3 == "" ? "-" : $3), $5, mark }' \
      | pick "undo" single "Which change should be reverted?" || true)"
    [[ -n "$target" ]] || die "nothing selected"
  elif [[ "$which" == "last" ]]; then
    # The most recent entry that can actually be reverted.
    target="$(printf '%s\n' "$groups" | awk -F'\t' '$6 == "1" { print $1; exit }')"
    [[ -n "$target" ]] || die "no undoable change in the log (ghost cleanups cannot be reversed)"
  elif [[ "$which" =~ ^[0-9]+$ ]]; then
    target="$(printf '%s\n' "$groups" | awk -F'\t' -v n="$which" 'NR == n { print $1; exit }')"
    [[ -n "$target" ]] || die "no entry #$which - try: open-with history"
  else
    die "undo takes 'last', a number from 'open-with history', or nothing for a picker"
  fi

  undo_group "$target"
}

# ------------------------------------------------------------------------ apply

# Set in main(). RESOLVED is the raw `jxa resolve` output for the chosen types;
# TOKEN_MAP is "uti<TAB>token" per line, derived from it.
RESOLVED=""
TOKEN_MAP=""
token_for() { printf '%s\n' "$TOKEN_MAP" | awk -F'\t' -v u="$1" '$1 == u { print $2; exit }'; }

apply() {
  local bid="$1" name="$2" app_path="$3"; shift 3
  local -a utis=("$@")

  clear_shadowing_ghosts "$app_path"

  local undeclared
  undeclared="$(jxa declares "$bid" "${utis[@]}" | awk -F'\t' '$2 == "0" { print $1 }' || true)"
  if [[ -n "$undeclared" ]]; then
    warn "$name does not advertise support for: $(printf '%s\n' "$undeclared" | tr '\n' ' ')"
    warn "Setting it anyway - this is what Finder's \"Change All\" does too."
  fi

  if [[ $DRY_RUN -eq 1 ]]; then
    printf '\n%sDry run - would set %s as the default for:%s\n' "$YELLOW" "$name" "$RESET"
    printf '  %s\n' "${utis[@]}"
    return 0
  fi

  # Previous handlers come from the resolve in main() - the same values the
  # confirmation prompt showed. That is what undo restores.
  local results failed=0 group
  group="$(history_new_group)"
  results="$(jxa set "$bid" "${utis[@]}")"

  printf '\n'
  while IFS=$'\t' read -r uti status now; do
    [[ -n "$uti" ]] || continue
    if [[ "$status" == "ok" ]]; then
      local prev
      prev="$(printf '%s\n' "$RESOLVED" | awk -F'\t' -v u="$uti" '$2 == u { print $6; exit }')"
      history_record "$group" set "$uti" "$prev" "$bid" "$name" "" "$(token_for "$uti")"
      printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$uti"
    else
      failed=1
      printf '  %s✗%s %s %s(still %s)%s\n' "$RED" "$RESET" "$uti" "$DIM" "${now:-unset}" "$RESET"
    fi
  done <<< "$results"

  if [[ $failed -eq 1 ]]; then
    printf '\n%sSome types did not take.%s Try: open-with --doctor\n' "$YELLOW" "$RESET"
    return 1
  fi

  printf '\n%s✓%s %s is now the default for %s type(s).\n' "$GREEN" "$RESET" "$BOLD$name$RESET" "${#utis[@]}"
  printf '%s  Already-open Finder windows may need a restart to catch up.%s\n' "$DIM" "$RESET"
  printf '%s  Changed your mind? open-with undo last%s\n' "$DIM" "$RESET"
}

list_types() {
  local -a tokens=("$@")
  if [[ ${#tokens[@]} -eq 0 ]]; then
    tokens=(md json yaml toml xml csv html css js ts py sh txt pdf png svg zip)
  fi
  printf '\n%s%-14s %-30s %s%s\n' "$BOLD" "TYPE" "UTI" "OPENS WITH" "$RESET"
  jxa resolve "${tokens[@]}" | awk -F'\t' -v d="$DIM" -v r="$RESET" -v y="$YELLOW" '
    {
      if ($2 == "") { printf "%-14s %s(unrecognised)%s\n", $1, y, r; next }
      dyn = ($4 == "0") ? y "  dynamic" r : ""
      printf "%-14s %s%-30s%s %s%s\n", $1, d, $2, r, ($7 != "" ? $7 : "(none)"), dyn
    }'
  printf '\n'
}

# ------------------------------------------------------------------------- main

APP_QUERY=""
DRY_RUN=0
ASSUME_YES=0
ALL_APPS=0
DO_LIST=0
DO_DOCTOR=0
TOKENS=()

# `undo` and `history` read as verbs, so accept them as a leading subcommand.
# An extension genuinely called "undo" can still be written as ".undo".
SUBCOMMAND=""
UNDO_ARG=""
if [[ $# -gt 0 ]]; then
  case "$1" in
    undo|history|log) SUBCOMMAND="$1"; shift
                      if [[ $# -gt 0 && "$1" != -* ]]; then UNDO_ARG="$1"; shift; fi ;;
  esac
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --undo)        SUBCOMMAND="undo"
                   if [[ $# -ge 2 && "$2" != -* ]]; then UNDO_ARG="$2"; shift 2; else shift; fi ;;
    --undo=*)      SUBCOMMAND="undo"; UNDO_ARG="${1#*=}"; shift ;;
    --history)     SUBCOMMAND="history"; shift ;;
    -w|--with)     [[ $# -ge 2 ]] || die "--with needs an application"; APP_QUERY="$2"; shift 2 ;;
    --with=*)      APP_QUERY="${1#*=}"; shift ;;
    -l|--list)     DO_LIST=1; shift ;;
    --groups)      show_groups; exit 0 ;;
    -d|--doctor)   DO_DOCTOR=1; shift ;;
    -a|--all-apps) ALL_APPS=1; shift ;;
    -n|--dry-run)  DRY_RUN=1; shift ;;
    -y|--yes)      ASSUME_YES=1; shift ;;
    -q|--quiet)    QUIET=1; shift ;;
    -h|--help)     usage; exit 0 ;;
    -V|--version)  printf 'open-with %s\n' "$VERSION"; exit 0 ;;
    --)            shift; while [[ $# -gt 0 ]]; do TOKENS+=("$1"); shift; done ;;
    -*)            die "unknown option: $1  (try --help)" ;;
    *)             TOKENS+=("$1"); shift ;;
  esac
done

[[ "$(uname -s)" == "Darwin" ]] || die "this only makes sense on macOS"
[[ "$(sw_vers -productVersion | cut -d. -f1)" -ge 12 ]] || die "needs macOS 12 (Monterey) or later"

case "$SUBCOMMAND" in
  history|log) show_history; exit 0 ;;
  undo)        do_undo "$UNDO_ARG"; exit $? ;;
esac

if [[ $DO_DOCTOR -eq 1 ]]; then doctor; exit $?; fi

# ---- 1. which types?

if [[ ${#TOKENS[@]} -eq 0 && $DO_LIST -eq 0 ]]; then
  [[ -t 0 ]] || die "no types given and no terminal to ask on"
  while IFS= read -r line; do
    [ -n "$line" ] && TOKENS+=("$line")
  done < <(pick_types || true)
  [[ ${#TOKENS[@]} -gt 0 ]] || die "nothing selected"
fi

# Normalise every token, whether typed, picked, or expanded from a @group:
#   @images        -> every extension in that group
#   ~/notes/x.md   -> md   (an actual file; its extension is used)
#   *.md  .md      -> md
# The name "open-with" invites "open THIS FILE with that app". It does not do
# that (see `open -a`); it changes the default for the whole type. When someone
# hands us a real file, say so plainly before changing anything.
NORMALISED=()
FILE_HINTS=""
for tok in "${TOKENS[@]+"${TOKENS[@]}"}"; do
  if [[ "$tok" == @* ]]; then
    exts="$(group_extensions "${tok#@}")" || die "unknown group '$tok' - try: open-with --groups"
    while IFS= read -r ext; do NORMALISED+=("$ext"); done <<< "$exts"
  elif [[ -e "$tok" && "$tok" == *.* ]]; then
    NORMALISED+=("${tok##*.}")
    FILE_HINTS="${FILE_HINTS}$(basename "$tok")	${tok##*.}
"
  else
    tok="${tok#\*}"          # *.md -> .md
    NORMALISED+=("${tok#.}") # .md  -> md
  fi
done

if [[ $DO_LIST -eq 1 ]]; then list_types "${NORMALISED[@]+"${NORMALISED[@]}"}"; exit 0; fi

RESOLVED="$(jxa resolve "${NORMALISED[@]}")"
TOKEN_MAP="$(printf '%s\n' "$RESOLVED" | awk -F'\t' '$2 != "" { print $2 "\t" $1 }')"

UTIS=()
SEEN=""
while IFS=$'\t' read -r token uti _ declared desc _ curname; do
  [[ -n "$token" ]] || continue
  if [[ -z "$uti" ]]; then
    warn "could not work out a type for '$token' - skipping"
    continue
  fi
  case " $SEEN " in *" $uti "*) continue ;; esac
  SEEN="$SEEN $uti"
  UTIS+=("$uti")
  if [[ "$declared" == "0" ]]; then
    warn "'$token' has no registered type on this Mac; using a dynamic identifier"
  fi
done <<< "$RESOLVED"

[[ ${#UTIS[@]} -gt 0 ]] || die "no usable types"

# ---- 2. which app?

if [[ -z "$APP_QUERY" ]]; then
  [[ -t 0 ]] || die "no application given and no terminal to ask on"
  APP_QUERY="$(pick_app "${UTIS[@]}" || true)"
  [[ -n "$APP_QUERY" ]] || die "no application selected"
fi

APP_INFO="$(jxa app "$APP_QUERY" || true)"
[[ -n "$APP_INFO" ]] || die "no application matching '$APP_QUERY' (name, path or bundle id)"
IFS=$'\t' read -r APP_BID APP_NAME APP_PATH <<< "$APP_INFO"

# ---- 3. confirm and apply

if [[ $ASSUME_YES -eq 0 && $DRY_RUN -eq 0 && -t 0 ]]; then
  printf '\n%sSet %s%s%s as the default for:%s\n' "$BOLD" "$CYAN" "$APP_NAME" "$RESET$BOLD" "$RESET"
  while IFS=$'\t' read -r token uti _ declared desc _ curname; do
    [[ -n "$uti" ]] || continue
    printf '  %-10s %s%-28s%s %s%s → %s%s\n' \
      "$token" "$DIM" "${desc:-$uti}" "$RESET" "$DIM" "${curname:-none}" "$APP_NAME" "$RESET"
  done <<< "$RESOLVED"

  if [[ -n "$FILE_HINTS" ]]; then
    printf '\n'
    while IFS=$'\t' read -r fname fext; do
      [[ -n "$fname" ]] || continue
      printf '%s  Note: this applies to every .%s file, not just %s.%s\n' \
        "$YELLOW" "$fext" "$fname" "$RESET"
    done <<< "$FILE_HINTS"
    printf '%s  To open one file once, use: open -a %s %s%s\n' \
      "$DIM" "$APP_NAME" "$(printf '%s\n' "$FILE_HINTS" | head -1 | cut -f1)" "$RESET"
  fi

  printf '\n%sProceed?%s [Y/n] ' "$BOLD" "$RESET"
  read -r REPLY </dev/tty || REPLY=""
  [[ -z "$REPLY" || "$REPLY" =~ ^[Yy] ]] || { info "Cancelled."; exit 0; }
fi

apply "$APP_BID" "$APP_NAME" "$APP_PATH" "${UTIS[@]}"
